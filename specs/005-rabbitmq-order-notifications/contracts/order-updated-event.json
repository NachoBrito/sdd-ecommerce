{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderUpdatedEvent",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "orderId",
    "orderStatus",
    "timestamp"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "order.updated.v1"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "orderStatus": {
      "type": "string",
      "enum": ["CONFIRMED", "SHIPPED", "DELIVERED", "CANCELLED"]
    },
    "totalAmountInCents": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string"
    }
  }
}
